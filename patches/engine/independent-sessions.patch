+/* Each PHP PDO owns a real embedded MariaDB connection. All queries execute
+   synchronously on this worker, so selecting the handle cannot interleave. */
+EMSCRIPTEN_KEEPALIVE
+int l4m_session_open(void)
+{
+  if (!g_open) return 0;
+  unsigned slot;
+  for (slot= 0; slot < L4M_SESSION_LIMIT && g_sessions[slot]; slot++) {}
+  if (slot == L4M_SESSION_LIMIT) return 0;
+  MYSQL *connection= mysql_init(NULL);
+  if (!connection) return 0;
+  if (!mysql_real_connect(connection, NULL, "root", "", NULL, 0, NULL,
+                          CLIENT_MULTI_STATEMENTS))
+  {
+    mysql_close(connection);
+    return 0;
+  }
+  g_sessions[slot]= connection;
+  return (int)slot + 1;
+}
+
+EMSCRIPTEN_KEEPALIVE
+char *l4m_session_query(int session, const char *sql)
+{
+  if (session < 1 || session > L4M_SESSION_LIMIT || !g_sessions[session - 1])
+    return json_err_state(2006, "Session is closed", "08003");
+  MYSQL *previous= g_mysql;
+  g_mysql= g_sessions[session - 1];
+  char *result= l4m_query(sql);
+  g_mysql= previous;
+  return result;
+}
+
+EMSCRIPTEN_KEEPALIVE
+void l4m_session_close(int session)
+{
+  if (session < 1 || session > L4M_SESSION_LIMIT || !g_sessions[session - 1])
+    return;
+  mysql_close(g_sessions[session - 1]);
+  g_sessions[session - 1]= NULL;
+}
