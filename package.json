{
  "name": "@joomengine/mariadb-wasm-bridge",
  "version": "0.1.8",
  "description": "MariaDB WebAssembly engine and native PDO extension for upstream PHP WASM",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joomengine/mariadb-wasm-bridge.git"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs"
    },
    "./php-wasm": {
      "types": "./types/php-wasm.d.ts",
      "import": "./adapters/php-wasm.mjs"
    }
  },
  "types": "./types/index.d.ts",
  "files": [
    "src",
    "types",
    "adapters",
    "native",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "vendor",
    "patches",
    "scripts/build-engine.mjs"
  ],
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "npm run check && npm run test:integration && npm run test:browser",
    "test:integration": "npm run prepare:engine && node --test test/result.test.mjs test/engine-patch.test.mjs test/engine.test.mjs test/bridge.test.mjs test/release.test.mjs",
    "test:browser": "npm run prepare:engine && node --test test/browser.test.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:prepare": "node scripts/prepare-version.mjs",
    "test:native": "npm run prepare:engine && bash native/tests/run.sh && node --test native/tests/database.test.mjs",
    "prepare:engine": "node scripts/prepare-engine.mjs",
    "prepack": "npm run prepare:engine",
    "build:upstream": "bash native/build-upstream.sh",
    "test:upstream": "npm run prepare:engine && node --test native/tests/upstream.test.mjs",
    "build:engine": "node scripts/build-engine.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "yaml": "2.9.1",
    "lite4mariadb": "0.1.2",
    "php-wasm": "0.2.0",
    "php-cgi-wasm": "0.2.0"
  }
}
